# 复制为 .env.backend.local，密钥仅保存在本机，文件已被 Git 忽略。
INKLOOM_MODEL=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
INKLOOM_CALL_TIMEOUT=60s
INKLOOM_MAX_CALLS=14
INKLOOM_MAX_TOKENS=128000
# 整章生成与作者修改使用独立预算；达到上限时明确停止。
INKLOOM_CHAPTER_MAX_CALLS=48
INKLOOM_CHAPTER_MAX_TOKENS=512000
INKLOOM_HUMAN_OPERATION_TOKENS=256000
INKLOOM_MAX_OUTPUT_TOKENS=8192
# 一致性审核独立上限；不代表固定等待时长，仍受总运行预算与截止时间约束。
INKLOOM_CONSISTENCY_OUTPUT_TOKENS=30000
INKLOOM_CONSISTENCY_TIMEOUT=90s
# 实验衔接检查尚未稳定通过质量验收，保持关闭。
INKLOOM_EXPERIMENTAL_CONTINUITY=false
# 上下文材料预算，按 UTF-8 字节保守估计；不是供应商精确 token 数。
INKLOOM_CONTEXT_TOKENS=65536

# HTTP 服务必填；CLI 离线运行不需要数据库。此例使用本机 PostgreSQL Unix socket。
INKLOOM_DATABASE_URL=postgres:///inkloom_learning?host=/tmp

# I10：向量模型独立于正文模型。none=仅关键词；fake 只允许配合 Fake 正文；zhipu=真实语义搜索。
INKLOOM_EMBEDDER=none
ZHIPU_API_KEY=
INKLOOM_EMBEDDING_DIMENSIONS=1024
# 模型/权重更新时换 revision，避免混用旧向量；维度也包含在缓存身份中。
INKLOOM_EMBEDDING_REVISION=v1
