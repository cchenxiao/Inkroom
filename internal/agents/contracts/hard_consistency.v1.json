{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "critic",
          "severity",
          "segmentId",
          "quote",
          "evidenceRefs",
          "reason",
          "suggestion",
          "repairScope",
          "draftVersion",
          "ruleRef",
          "ruleQuote",
          "evidenceStatus",
          "possibleDialogueLie",
          "requiresHuman"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "critic": {
            "const": "hard_consistency"
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P3"
            ]
          },
          "segmentId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "repairScope": {
            "enum": [
              "segment",
              "scene",
              "beat",
              "outline",
              "cross_chapter"
            ]
          },
          "draftVersion": {
            "type": "integer",
            "minimum": 1
          },
          "ruleRef": {
            "type": "string",
            "minLength": 1
          },
          "ruleQuote": {
            "type": "string",
            "minLength": 1
          },
          "evidenceStatus": {
            "enum": [
              "confirmed",
              "uncertain"
            ]
          },
          "possibleDialogueLie": {
            "type": "boolean"
          },
          "requiresHuman": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
