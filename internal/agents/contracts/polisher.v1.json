{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"object","additionalProperties":false,"required":["basedOnDraftVersion","patches"],
 "properties":{
  "basedOnDraftVersion":{"type":"integer","minimum":1},
  "patches":{"type":"array","maxItems":64,"items":{
   "type":"object","additionalProperties":false,
   "required":["findingId","segmentId","changeType","oldText","newText","reason"],
   "properties":{
    "findingId":{"type":"string","minLength":1},"segmentId":{"type":"string","minLength":1},
    "changeType":{"enum":["replace","delete"]},"oldText":{"type":"string","minLength":1},
    "newText":{"type":"string"},"reason":{"type":"string","minLength":1,"pattern":"\\S"}
   }
  }}
 }
}
