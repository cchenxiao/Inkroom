{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "critic",
          "severity",
          "segmentId",
          "quote",
          "evidenceRefs",
          "reason",
          "suggestion",
          "repairScope",
          "draftVersion",
          "evidence",
          "evidenceStatus",
          "possibleDialogueLie",
          "requiresHuman"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "critic": {
            "enum": [
              "hard_consistency",
              "ai_taste"
            ]
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "segmentId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "repairScope": {
            "enum": [
              "phrase",
              "segment",
              "scene",
              "beat",
              "outline",
              "cross_chapter"
            ]
          },
          "draftVersion": {
            "type": "integer",
            "minimum": 1
          },
          "evidenceStatus": {
            "enum": [
              "confirmed",
              "uncertain"
            ]
          },
          "possibleDialogueLie": {
            "type": "boolean"
          },
          "requiresHuman": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "quote"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
